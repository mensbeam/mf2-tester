cabal-version: 2.4
name:          mftester
version:       0.1.0.0
synopsis:      Parse microformats2 from an HTML file and emit JSON

executable test-one
  main-is:          Main.hs
  default-language: Haskell2010

  build-depends:
      base              >= 4.14 && < 5
    , data-default
    , microformats2-parser
    , aeson             >= 2.0
    , aeson-pretty
    , text
    , bytestring
    , network-uri